# Postgres (Coolify-managed, internal Docker network — see
# C:\Users\NBC\mechanicshophub-secrets\infrastructure-reference.md)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Better Auth
BETTER_AUTH_SECRET="" # generate with: openssl rand -hex 32
BETTER_AUTH_URL="http://localhost:3000" # the deployed app's own URL in production
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000" # same value, exposed to the browser

# Platform-default email (Hostinger Titan SMTP) — used until a shop
# configures its own provider at Settings -> Email
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Encrypts per-shop email credentials (API keys / SMTP passwords) before
# they're stored in the DB. generate with: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=""

# Garage (self-hosted, S3-compatible — see C:\Users\NBC\mechanicshophub-secrets\infrastructure-reference.md).
# Used for shop logo uploads (Settings -> Shop Profile) and anything later
# that needs file storage (receipt photos, invoice PDFs). Same S3 API as
# MinIO/R2/AWS, so swapping providers is a value change here, not a
# code change — see src/lib/storage.ts.
S3_ENDPOINT=""
S3_REGION="garage"
S3_BUCKET="mechanicshophub"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
