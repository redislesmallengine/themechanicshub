// Mechanic Shop Hub — Prisma schema
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Better Auth — core tables
// Field shapes hand-matched against the exact schema shipped in
// node_modules/@better-auth/core/dist/db/schema/*.mjs and
// node_modules/better-auth/dist/plugins/organization/schema.mjs for the
// installed version (better-auth 1.7.3), since the CLI generator that
// normally produces this is flagged deprecated and hung against an
// unreachable placeholder DB rather than completing.
// =============================================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions          Session[]
  accounts          Account[]
  memberships       Member[]
  invitationsSent   Invitation[]  @relation("InvitationInviter")
  teamMemberships   TeamMember[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Added by the organization plugin — which shop/team a session is
  // currently "acting as", for staff who belong to more than one shop.
  activeOrganizationId String?
  activeTeamId         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // only set for the email/password credential provider
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// =============================================================================
// Better Auth — organization plugin (this IS our multi-tenant model:
// Organization = shop/tenant, Member = staff membership + role)
// =============================================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  String? // JSON-encoded; Better Auth reads/writes this as a string
  createdAt DateTime @default(now())

  members       Member[]
  invitations   Invitation[]
  teams         Team[]
  emailSettings EmailSettings?
}

// =============================================================================
// Mechanic Shop Hub — app-owned tables (not part of Better Auth)
// =============================================================================

// Per-shop outbound email configuration, editable from Settings → Email
// instead of Coolify env vars. `credentials` holds provider-specific secrets
// (API keys / SMTP password) AES-256-GCM encrypted at the application layer
// (src/lib/crypto.ts) before they ever reach the database — never plaintext
// at rest. Falls back to the platform's own Hostinger SMTP env vars
// (src/lib/email.ts) when no shop has configured this yet.
model EmailSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  provider       String // "resend" | "sendgrid" | "smtp"
  fromName       String
  fromEmail      String
  credentials    String // JSON, AES-256-GCM encrypted (see src/lib/crypto.ts)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String // one of: owner | manager | technician | bookkeeper | frontdesk (src/lib/permissions.ts)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String
  status         String   @default("pending") // pending | accepted | rejected | canceled
  teamId         String?
  inviterId      String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model Team {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]

  @@index([organizationId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}
