// Mechanic Shop Hub — Prisma schema
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Better Auth — core tables
// Field shapes hand-matched against the exact schema shipped in
// node_modules/@better-auth/core/dist/db/schema/*.mjs and
// node_modules/better-auth/dist/plugins/organization/schema.mjs for the
// installed version (better-auth 1.7.3), since the CLI generator that
// normally produces this is flagged deprecated and hung against an
// unreachable placeholder DB rather than completing.
// =============================================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Platform-level flag, unrelated to any shop's Member.role — the "site
  // administrator" concept from src/lib/rbac.ts. Sits above every
  // organization; manages the shared Role library (PlatformRole below)
  // instead of any one shop's own data. Not settable from the app itself —
  // per the standing "credentials & accounts are always asked for, never
  // assumed" rule, the first site admin is promoted by hand via direct DB
  // access (Prisma Studio / TablePlus), never auto-granted by a migration.
  isSiteAdmin Boolean @default(false)

  sessions             Session[]
  accounts             Account[]
  memberships          Member[]
  invitationsSent      Invitation[]          @relation("InvitationInviter")
  teamMemberships      TeamMember[]
  partStockAdjustments PartStockAdjustment[]
  assignedWorkOrders   WorkOrder[]
  savedViews           SavedView[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Added by the organization plugin — which shop/team a session is
  // currently "acting as", for staff who belong to more than one shop.
  activeOrganizationId String?
  activeTeamId         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // only set for the email/password credential provider
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// =============================================================================
// Better Auth — organization plugin (this IS our multi-tenant model:
// Organization = shop/tenant, Member = staff membership + role)
// =============================================================================

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  String? // JSON-encoded; Better Auth reads/writes this as a string
  createdAt DateTime @default(now())

  members           Member[]
  invitations       Invitation[]
  teams             Team[]
  emailSettings     EmailSettings?
  emailLogs         EmailLog[]
  organizationRoles OrganizationRole[]
  shopProfile       ShopProfile?
  equipmentTypes    EquipmentType[]
  customers         Customer[]
  equipment         Equipment[]
  partCategories    PartCategory[]
  parts             Part[]
  workOrders        WorkOrder[]
  invoices          Invoice[]
  savedViews        SavedView[]
}

// =============================================================================
// Mechanic Shop Hub — app-owned tables (not part of Better Auth)
// =============================================================================

// Per-shop outbound email configuration, editable from Settings → Email
// instead of Coolify env vars. A shop can configure any/all of the three
// providers; src/lib/email.ts sends through them in priority order —
// Resend, then SendGrid, then this shop's own SMTP, then the platform's
// Hostinger env-var default — falling through to the next whenever the
// current one is out of quota (tracked via EmailLog) or the send itself
// fails. Each *Credentials field is JSON, AES-256-GCM encrypted at the
// application layer (src/lib/crypto.ts) before it ever reaches the
// database — never plaintext at rest. Null means that provider isn't
// configured for this shop and is skipped.
model EmailSettings {
  id                  String   @id @default(cuid())
  organizationId      String   @unique
  fromName            String
  fromEmail           String
  resendCredentials   String? // encrypted { apiKey }
  sendgridCredentials String? // encrypted { apiKey }
  smtpCredentials     String? // encrypted { host, port, user, password }
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// One row per send attempt, per provider — purely so src/lib/email.ts can
// count "how many did Resend/SendGrid/SMTP already send in the current
// window" and know when to fall through to the next provider in the
// cascade before that provider's own free-tier cap gets hit.
model EmailLog {
  id             String   @id @default(cuid())
  organizationId String
  provider       String // "resend" | "sendgrid" | "smtp"
  success        Boolean
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider, createdAt])
}

// Phase 2 — Shop Configuration. Everything later phases read as "the
// shop's own settings" that Better Auth's Organization model doesn't cover
// (name/slug/logo live there already; this is the rest — branding beyond
// the logo, contact info, and the billing defaults invoicing (Phase 6)
// pulls in automatically instead of asking for labor rate/tax on every
// invoice). One row per shop, created on first save (upsert), so it's
// fine for a brand-new shop to have none yet — Settings -> Shop Profile
// just shows empty fields.
model ShopProfile {
  id                String   @id @default(cuid())
  organizationId    String   @unique
  logoKey           String? // object key in the Garage/S3 bucket (src/lib/storage.ts) — not a public URL, served via /api/shop-logo/[organizationId]
  address           String?
  phone             String?
  labourRate        Decimal? @db.Decimal(10, 2) // per hour
  diagnosticFee     Decimal? @db.Decimal(10, 2) // flat fee
  taxRate           Decimal? @db.Decimal(5, 2) // percentage, e.g. 15.00
  taxLabel          String? // e.g. "HST", "GST+PST"
  province          String?
  agingAlertDays    Int      @default(14) // Phase 4 — flag a work order sitting in "Ready for Pickup" past this many days
  nextInvoiceNumber Int      @default(1001) // Phase 6 — incremented atomically (src/lib/invoices.ts) each time an invoice is generated; the number used is this value *before* the increment
  facebookUrl       String? // shown on the invoice (PDF + public view page) if set
  googleReviewUrl   String? // shop's "leave a review" link (Google Business Profile) — shown as a button on the invoice if set
  hstNumber         String? // government tax registration number (HST/GST) — printed in the invoice footer if set
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// =============================================================================
// Phase 3 — Customer & Equipment CRM
// =============================================================================

// Per-shop, not shared like PlatformRole — unlike roles (where consistent
// access control across the platform matters), a shop's equipment taxonomy
// is business data specific to its specialty (a marine shop and a lawn-
// equipment shop want completely different lists). Managed from Settings
// -> Equipment Types by anyone with shopSettings:update; seeded with a
// sensible default set both for existing orgs (this migration) and new
// ones (organizationHooks.afterCreateOrganization in src/lib/auth.ts).
model EquipmentType {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipment    Equipment[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  address        String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipment    Equipment[]
  workOrders   WorkOrder[]
  invoices     Invoice[]

  @@index([organizationId])
  @@index([organizationId, phone])
  @@index([organizationId, email])
}

// Registration/identification data only — no diagnosis, repair status, or
// pricing here. That's Phase 4's WorkOrder, linked to a piece of equipment
// once it exists; "service history" on an equipment's detail page is just
// that equipment's past work orders, not a field stored here.
model Equipment {
  id              String   @id @default(cuid())
  organizationId  String
  customerId      String
  equipmentTypeId String?
  make            String?
  model           String?
  serialNumber    String?
  engineType      String? // "2-stroke" | "4-stroke" | "electric" | "battery" — free text, not an enum, in case a shop needs something else
  displacement    String? // free text — units vary by equipment ("42cc", "11 HP")
  year            Int?
  photoKey        String? // Garage/S3 object key, same pattern as ShopProfile.logoKey — never a public URL, see /api/equipment-photo
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  equipmentType EquipmentType? @relation(fields: [equipmentTypeId], references: [id], onDelete: SetNull)
  workOrders    WorkOrder[]
  invoices      Invoice[]

  @@index([organizationId])
  @@index([customerId])
  @@index([organizationId, serialNumber])
}

// =============================================================================
// Phase 5 — Inventory & Parts Management
// =============================================================================

// Per-shop, same reasoning as EquipmentType — a small-engine shop's parts
// taxonomy is its own business data, not a platform-shared thing. Managed
// from Settings -> Part Categories.
model PartCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parts        Part[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// quantityOnHand only ever changes through a PartStockAdjustment row (see
// below) — never edited directly on this model — so "what's on the shelf"
// always has a reason attached, not just a number that changed silently.
// Work Order parts-reservation (Phase 4) and invoice-payment auto-decrement
// (Phase 6/7) will both create adjustments here once they exist, rather
// than needing their own separate stock-tracking logic.
//
// name/sku/barcode also carry a pg_trgm GIN index each (see migration
// 20260916110000_inventory_trigram_search) -- not expressible here without
// the postgresqlExtensions preview feature, but Postgres picks them up
// automatically for the existing ILIKE search, no query code change needed.
model Part {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String?
  name           String
  sku            String?
  barcode        String?
  binLocation    String?
  costPrice      Decimal? @db.Decimal(10, 2)
  sellPrice      Decimal? @db.Decimal(10, 2)
  quantityOnHand Int      @default(0)
  reorderPoint   Int      @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category         PartCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  adjustments      PartStockAdjustment[]
  workOrderParts   WorkOrderPart[]
  invoiceLineItems InvoiceLineItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([organizationId, barcode])
}

model PartStockAdjustment {
  id              String   @id @default(cuid())
  partId          String
  delta           Int // positive = added, negative = removed
  reason          String // "Restock" | "Correction" | "Damaged/Lost" | "Return to Supplier" | "Used on Work Order" | "Other"
  note            String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  part      Part  @relation(fields: [partId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([partId])
}

// Staff-created, shop-wide filter shortcuts -- "resource" scopes this one
// table to whichever list page saved it (starting with "inventory"; other
// list pages with the same load-everything-then-filter problem can reuse it
// later instead of getting their own table). "filters" is the list page's
// own query-string params as JSON (e.g. {"q":"belt","stock":"low"}) --
// applying a view is just navigating to that URL, no separate filtering
// logic needed. Shared across the whole shop (not per-user) since a small
// team benefits more from "here's the view I use" being visible to everyone
// than from private lists; any staff member with inventory access can
// create or remove one.
model SavedView {
  id              String   @id @default(cuid())
  organizationId  String
  resource        String
  name            String
  filters         String // JSON-encoded
  createdByUserId String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, resource, name])
  @@index([organizationId, resource])
}

// =============================================================================
// Phase 4 — Work Orders & Bench Workflow
// =============================================================================

// Status is a plain string, not a DB enum — matches the pattern already used
// for Member.role — checked against WORK_ORDER_STATUSES in
// src/lib/work-orders.ts. Flow: droppedOff -> diagnosing -> awaitingApproval
// -> inRepair -> readyForPickup -> closed, with a declined branch off
// awaitingApproval. Every forward move is a deliberate action on the detail
// page, not a free dropdown.
model WorkOrder {
  id                 String    @id @default(cuid())
  organizationId     String
  customerId         String
  equipmentId        String
  status             String    @default("droppedOff")
  complaint          String
  diagnosisNotes     String?
  labourHours        Decimal?  @db.Decimal(6, 2)
  assignedToUserId   String?
  estimateAmount     Decimal?  @db.Decimal(10, 2)
  estimateNotes      String?
  approvalToken      String?   @unique // powers the public /estimate/[token] page
  approvalMethod     String? // "link" | "phone" | "in-person"
  decidedByName      String? // typed on the approval page, staff-entered for a phone decision, or the customer's own name for an in-person/drop-off authorization
  decidedAt          DateTime?
  notToExceedAmount  Decimal?  @db.Decimal(10, 2) // optional verbal price ceiling captured on the "skip formal estimate" fast path — see skipEstimateApproval
  awaitingApprovalAt DateTime? // set when status first becomes awaitingApproval — what the "waiting 2+ days" dashboard flag measures from
  readyForPickupAt   DateTime? // set when status first becomes readyForPickup — what the aging alert measures from
  closedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  equipment    Equipment       @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  assignedTo   User?           @relation(fields: [assignedToUserId], references: [id], onDelete: SetNull)
  parts        WorkOrderPart[]
  invoice      Invoice?

  @@index([organizationId, status])
  @@index([customerId])
  @@index([equipmentId])
}

// Adding a line here immediately creates a real PartStockAdjustment (reason
// "Used on Work Order") against the linked Part — src/lib/inventory.ts's
// applyStockAdjustment() is the single place stock ever actually changes,
// shared with Settings -> Inventory's own manual "Adjust Stock" action, so
// there's exactly one code path that can move quantityOnHand. name/
// unitSellPrice/unitCostPrice are snapshotted at the moment a part is added
// — survives the part later being renamed, repriced, or deleted, and gives
// Phase 6 invoicing accurate historical numbers to build a line item from
// without having to guess.
model WorkOrderPart {
  id            String   @id @default(cuid())
  workOrderId   String
  partId        String?
  name          String
  quantity      Int
  unitCostPrice Decimal? @db.Decimal(10, 2)
  unitSellPrice Decimal? @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part      Part?     @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
}

// =============================================================================
// Phase 6 — Itemized Invoicing & Tax Calculation
// =============================================================================

// An invoice from a Work Order (Repair Service) or created standalone
// (Parts Only) -- workOrderId/customerId/equipmentId are all optional so a
// counter sale never needs a work order, customer, or registered equipment
// behind it. invoiceType is auto-derived from what's actually on the
// invoice (src/lib/invoices.ts's classifyInvoiceType), not staff-chosen --
// stored rather than computed on read so it's directly filterable/reportable
// later (Phase 9 parts-vs-labour margin reporting).
// subtotal/taxAmount/total are stored, not computed on read, so a past
// invoice's numbers stay fixed even if the shop's tax rate changes later —
// recalculated only when a line item actually changes (src/lib/invoices.ts).
model Invoice {
  id                  String    @id @default(cuid())
  organizationId      String
  workOrderId         String?   @unique
  customerId          String?
  equipmentId         String? // machine this invoice is for -- live-linked (not snapshotted), so an edited Equipment record updates past invoices too
  adHocEquipmentLabel String? // free-text machine description when there's no registered Equipment (and often no Customer) behind this invoice at all -- e.g. a walk-in repair with nothing on file. Mutually exclusive with equipmentId -- see createStandaloneInvoice.
  invoiceType         String    @default("partsOnly") // "partsOnly" | "repairService" | "combined" -- see classifyInvoiceType
  invoiceNumber       String // e.g. "INV-1001" — from ShopProfile.nextInvoiceNumber
  status              String    @default("draft") // draft | sent | viewed | paid | void
  issueDate           DateTime  @default(now())
  dueDate             DateTime  @default(now())
  subtotal            Decimal   @default(0) @db.Decimal(10, 2)
  taxAmount           Decimal   @default(0) @db.Decimal(10, 2)
  total               Decimal   @default(0) @db.Decimal(10, 2)
  notes               String?
  viewToken           String    @unique // powers the public /invoice/[token] page, same pattern as WorkOrder.approvalToken
  sentAt              DateTime?
  viewedAt            DateTime? // set the first time the customer opens their invoice link
  paidAt              DateTime?
  paymentMethod       String? // "Cash" | "E-transfer" | "Card" | "Cheque" | "Other"
  paymentReference    String?
  voidedAt            DateTime?
  voidReason          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder?        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  customer     Customer?         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  equipment    Equipment?        @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  lineItems    InvoiceLineItem[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status])
  @@index([customerId])
  @@index([equipmentId])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  invoiceId   String
  type        String // "labor" | "part" | "fee" | "custom"
  partId      String? // set ONLY when this line was rung up directly on the invoice via the "From Inventory" picker -- see addInventoryLineItem. A part line copied in from a Work Order (already decremented there) deliberately leaves this null, so a part's stock only ever moves once, never twice.
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(10, 2)
  unitCost    Decimal? @db.Decimal(10, 2) // "part" lines only — what the shop paid, shown only to invoice:viewMargins
  taxable     Boolean  @default(true)
  lineTotal   Decimal  @db.Decimal(10, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  part    Part?   @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([partId])
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String // "owner" (protected, hardcoded in src/lib/permissions.ts) or the `key` of a PlatformRole row
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// Better Auth organization plugin's own "Dynamic Access Control" table —
// exact field shape required by node_modules/better-auth/dist/plugins/
// organization/organization.mjs (organizationRoleSchema) with
// dynamicAccessControl enabled (src/lib/auth.ts). Better Auth reads this at
// request time and merges each row's `permission` JSON into its in-memory
// access-control engine, so auth.api.hasPermission() picks up custom roles
// automatically — no change needed at any existing call site.
//
// We never write here through Better Auth's own /organization/create-role
// etc. endpoints (those require the caller to already be a member of the
// target org, which a platform site admin isn't). Instead src/lib/rbac.ts
// writes directly to this table, mirroring every PlatformRole into every
// Organization's row set — see PlatformRole below for why.
model OrganizationRole {
  id             String    @id @default(cuid())
  organizationId String
  role           String // matches PlatformRole.key
  permission     String // JSON-encoded { [resource]: string[] } — Better Auth stores/reads this as a string, not jsonb
  createdAt      DateTime  @default(now())
  updatedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role])
  @@index([organizationId])
}

// The site administrator's shared role library (per the pilot-stage
// decision to keep one set of roles used by every shop rather than
// per-shop custom roles — see build plan Phase 10 for where per-shop
// customization would extend this later). This is the source of truth an
// admin edits in Site Admin → Roles; every write mirrors into
// OrganizationRole for every existing Organization so Better Auth's own
// runtime permission engine (which only reads OrganizationRole) sees the
// change immediately. "owner" is not a row here — it's the one role that
// stays hardcoded (src/lib/permissions.ts) since Better Auth's
// `creatorRole` setting requires a statically-defined role to exist for
// whoever creates a new shop to become its Owner.
model PlatformRole {
  id          String   @id @default(cuid())
  key         String   @unique // slug used as Member.role / OrganizationRole.role
  label       String
  description String?
  isSystem    Boolean  @default(false) // reserved for future protected roles; "owner" itself isn't a row here at all
  permissions Json // { [resource]: string[] } — same shape as src/lib/permissions.ts's `statement`
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String
  status         String   @default("pending") // pending | accepted | rejected | canceled
  teamId         String?
  inviterId      String
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model Team {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]

  @@index([organizationId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}
